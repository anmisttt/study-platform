NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate two DIFFERENT secrets: openssl rand -hex 32
BETTER_AUTH_SECRET=
LLM_KEY_ENCRYPTION_SECRET=
# Optional locally; configure both providers to enable their sign-in buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Required for registration, verification and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional: the standalone grade-practice CLI only. Never used by web requests.
OPENAI_API_KEY=
PORT=3001
HOST=127.0.0.1
# DATABASE_PATH=/absolute/path/study-platform.sqlite
