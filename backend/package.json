{
  "name": "study-platform-backend",
  "version": "1.0.0",
  "description": "Simple Express backend for study platform",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "grade-practice": "tsx src/scripts/gradePractice.ts",
    "cleanup-stale-rooms": "tsx src/scripts/cleanupStaleRooms.ts",
    "backup-database": "tsx src/scripts/backupDatabase.ts",
    "test:e2e-server": "NODE_ENV=test tsx test/e2e-server.ts"
  },
  "dependencies": {
    "@langfuse/client": "5.11.1",
    "@langfuse/openai": "5.11.1",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@opentelemetry/sdk-node": "0.222.0",
    "@study-platform/shared": "file:../shared",
    "better-auth": "1.7.5",
    "better-sqlite3": "^12.10.0",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "nodemailer": "10.0.10",
    "openai": "^7.4.0",
    "ws": "8.21.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.1",
    "eslint": "10.3.0",
    "globals": "17.6.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
