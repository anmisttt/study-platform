#!/usr/bin/env bash
# Installs npm dependencies and builds the packages whose output is missing or
# older than its sources, so a checkout is ready to run.
#
# Enable it once per clone:
#   git config core.hooksPath scripts/git-hooks
#
# Git runs this after `git checkout <branch>`, `git switch` and `git worktree add`,
# with the new working tree as the current directory. Together with
# .worktreeinclude - which copies the git-ignored local state (.env, the SQLite
# database, books/) that this hook cannot regenerate - it makes a fresh worktree
# usable without any manual setup.
#
# Set STUDY_PLATFORM_SKIP_SETUP=1 to skip it. Written for bash 3.2, the version
# macOS ships.
set -uo pipefail

[ "${3:-0}" = 1 ] || exit 0 # a file checkout, not a branch or worktree switch
[ -z "${STUDY_PLATFORM_SKIP_SETUP:-}" ] && [ -z "${CI:-}" ] || exit 0
if ! command -v npm >/dev/null 2>&1; then
  echo "post-checkout: npm is not on PATH, skipped dependency setup." >&2
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 0

say() { echo "post-checkout: $*" >&2; }
log_dir=$(git rev-parse --absolute-git-dir)
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')

# Each package with the file its build produces. shared is listed first: backend
# and frontend depend on it as "file:../shared".
packages="shared:dist/index.js backend:dist/server.js frontend:dist/index.html"

# npm records the tree it installed in node_modules/.package-lock.json, so a
# lockfile newer than that record means the install is out of date.
install_needed() { # <pkg>
  [ -f "$1/package-lock.json" ] || return 1
  [ -d "$1/node_modules" ] || return 0
  [ "$1/package-lock.json" -nt "$1/node_modules/.package-lock.json" ]
}

# A missing node_modules (as in a new worktree) is cloned from the main checkout
# when the lockfiles match, with APFS copy-on-write (cp -c): near-instant, and
# disk blocks are shared until a file changes. The clone's install record is
# touched so it looks newer than this checkout's lockfile.
clone_node_modules() { # <pkg>
  [ ! -e "$1/node_modules" ] && [ -d "$main/$1/node_modules" ] || return 1
  cmp -s "$main/$1/package-lock.json" "$1/package-lock.json" || return 1
  cp -c -R "$main/$1/node_modules" "$1/node_modules" 2>/dev/null || { rm -rf "$1/node_modules"; return 1; }
  touch "$1/node_modules/.package-lock.json"
}

# True when the build output is missing or any file in the package is newer. The
# whole package is scanned rather than a src/ directory, because the packages
# differ: shared keeps its sources at its root, backend uses src/, frontend adds
# index.html, public/ and the vite config. Directories holding dependencies or
# output of their own are pruned.
build_needed() { # <pkg> <output>
  [ -e "$2" ] || return 0
  [ -n "$(find "$1" \
    \( -name node_modules -o -name dist -o -name test-results -o -name playwright-report \) -prune \
    -o -type f -newer "$2" -print -quit 2>/dev/null)" ]
}

# Installs run in parallel: the packages are independent and npm ci is the slow step.
installs=""
for entry in $packages; do
  pkg=${entry%%:*}
  install_needed "$pkg" || continue
  if clone_node_modules "$pkg"; then
    say "cloned $pkg/node_modules from the main checkout."
    continue
  fi
  say "running npm ci in $pkg..."
  (cd "$pkg" && npm ci --no-audit --no-fund >"$log_dir/post-checkout-install-$pkg.log" 2>&1) &
  installs="$installs $pkg:$!"
done
for job in $installs; do
  pkg=${job%%:*}
  if wait "${job#*:}"; then
    say "npm ci done in $pkg."
  else
    say "npm ci failed in $pkg, see $log_dir/post-checkout-install-$pkg.log"
  fi
done

for entry in $packages; do
  pkg=${entry%%:*}
  [ -f "$pkg/package.json" ] && [ -d "$pkg/node_modules" ] || continue # a failed install leaves nothing to build with
  build_needed "$pkg" "$pkg/${entry#*:}" || continue
  say "building $pkg..."
  if (cd "$pkg" && npm run build >"$log_dir/post-checkout-build-$pkg.log" 2>&1); then
    say "built $pkg."
  else
    say "npm run build failed in $pkg, see $log_dir/post-checkout-build-$pkg.log"
  fi
done

# Git ignores this hook's exit code on checkout; never make it look like a failure.
exit 0
